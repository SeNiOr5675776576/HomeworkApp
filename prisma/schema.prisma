generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id  BigInt @id @default(autoincrement())
  telegramId BigInt @unique
  username String?
  createdAt DateTime @default(now())
  homework Homework[]
  schedule Schedule[]
  feedback Feedback[]
}

model Homework {
  id BigInt @id @default(autoincrement())
  subject String
  text String
  deadline DateTime
  done Boolean @default(false)
  userId BigInt @unique
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Schedule {
  id BigInt @id @default(autoincrement())
  dayOfWeek Int
  subject String
  time String
  userId BigInt
  user User @relation(fields: [userId], references: [id])
}

model Feedback {
  id BigInt @id @default(autoincrement())
  userId BigInt
  user User @relation(fields: [userId], references: [id])
  text String
  createdAt DateTime @default(now())
}