generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id  BigInt @id @default(autoincrement())
  telegramId BigInt @unique
  username String?
  createdAt DateTime @default(now())

  homework Homework[]
  overdue Overdue[]
  schedule Schedule[]
  feedback Feedback[]
  setting Setting[]
}

model Homework {
  id BigInt @id @default(autoincrement())
  userId BigInt
  subject String
  text String
  deadline DateTime
  done Boolean @default(false)
  overdue Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Overdue {
  id BigInt @id @default(autoincrement())
  userId BigInt
  subject String
  text String
  deadline DateTime
  done Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Schedule {
  id BigInt @id @default(autoincrement())
  userId BigInt
  dayOfWeek Int
  subject String
  time String
  
  user User @relation(fields: [userId], references: [id])
}

model Feedback {
  id BigInt @id @default(autoincrement())
  userId BigInt
  text String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Setting {
  id BigInt @id @default(autoincrement())
  userId BigInt
  scheduleEnabled Boolean @default(true)
  scheduleTime String @default("7:00")
  homeworkEnabled Boolean @default(true)
  homeworkTime String @default("16:00")

  user User @relation(fields: [userId], references: [id])
}